# =============================================================================
# AI 영상 자동화 파이프라인 - 환경 변수 (.env.example)
# 사용법: cp .env.example .env  → 값 채우기 → git 커밋 금지(.gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# 1) LLM 백엔드 스위치 (필수)
# -----------------------------------------------------------------------------
# ollama = Hybrid(기본, Mac mini 로컬 Ollama + Claude 다듬기)
# claude = Cloud-only (모든 LLM 호출을 Anthropic API 로)
LLM_BACKEND=ollama

# 다듬기(S2.5) 단계 모델. none 이면 이 단계 스킵.
# claude-haiku | claude-sonnet-4-6 | none
LLM_POLISH=claude-haiku

# -----------------------------------------------------------------------------
# 2) Anthropic (Claude)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# 3) Ollama (로컬 LLM, Mac mini)
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_WRITER=qwen2.5:14b
OLLAMA_MODEL_LIGHT=gemma4:e4b
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.5
OLLAMA_TOP_P=0.9
# 유휴 시 자동 언로드(TTS/ffmpeg 와의 메모리 충돌 방지). 0 = 호출 후 즉시 언로드
OLLAMA_KEEP_ALIVE=5m

# -----------------------------------------------------------------------------
# 4) TTS (OpenAI, 기본 엔진)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
# alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_VOICE=nova
OPENAI_TTS_FORMAT=mp3
OPENAI_TTS_SPEED=1.0

# -----------------------------------------------------------------------------
# 5) TTS (ElevenLabs, 선택 · 고품질 대안)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# 5-A) TTS (Azure Cognitive Services Speech, 선택)
# -----------------------------------------------------------------------------
# TTS_ENGINE=azure 로 전환 시 필수
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
# ko-KR-SunHiNeural | ko-KR-InJoonNeural | ...
AZURE_TTS_VOICE=ko-KR-SunHiNeural
# 429 Too Many Requests 대응 — F0 Free Tier 기준 기본값
AZURE_TTS_MAX_CONCURRENCY=15
AZURE_TTS_RETRY_MAX=5
AZURE_TTS_RETRY_BASE_SEC=2

# -----------------------------------------------------------------------------
# 6) 경로 설정 (프로젝트 루트 기준)
# -----------------------------------------------------------------------------
PROJECT_ROOT=/path/to/ai-video-public
INPUTS_DIR=${PROJECT_ROOT}/inputs
WORK_DIR=${PROJECT_ROOT}/work
VIDEOS_DIR=${PROJECT_ROOT}/videos
PROMPTS_DIR=${PROJECT_ROOT}/prompts
FONTS_DIR=${PROJECT_ROOT}/assets/fonts
# Optional: copy completed final MP4 + small run metadata to an htube/NAS library root.
# Leave empty to disable.
AIVIDEO_HTUBE_PUBLISH_ROOT=
# Example:
# AIVIDEO_HTUBE_PUBLISH_ROOT=/mnt/lvstarnas/video/htube/aivideo-published

# -----------------------------------------------------------------------------
# 7) DB (PostgreSQL 필수)
# -----------------------------------------------------------------------------
# Runtime DB는 PostgreSQL 전용이다. SQLite fallback은 지원하지 않는다.
# 실제 password/URL 전체를 문서나 로그에 출력하지 않는다.
AIVIDEO_DATABASE_URL=postgresql://aivideo_app:<password>@<db-host>:5432/aivideo
# DATABASE_URL은 AIVIDEO_DATABASE_URL이 없을 때만 사용된다.
DATABASE_URL=postgresql://aivideo_app:<password>@<db-host>:5432/aivideo

# -----------------------------------------------------------------------------
# 8) 렌더링 / ffmpeg
# -----------------------------------------------------------------------------
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=24
VIDEO_BITRATE=2000k
# Mac: libx264 | h264_videotoolbox   /   N100 Linux: libx264 | h264_qsv
VIDEO_CODEC=h264_videotoolbox
AUDIO_CODEC=aac
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
FONT_TITLE=Pretendard-Bold
FONT_BODY=Pretendard
FONT_CODE=JetBrainsMono-Regular

# -----------------------------------------------------------------------------
# 9) 대본 제약 (이운규식 7단 구조)
# -----------------------------------------------------------------------------
SCRIPT_MIN_CHARS=3000
# 생성 대본 길이 목표 (프롬프트 지시용)
SCRIPT_OUTPUT_MAX_CHARS=8000
# 이 이하면 그대로 사용 (Tier 1 pass-through)
SCRIPT_INPUT_SOFT_MAX=15000
# 이 이상이면 chapter split 필수 (Tier 3)
SCRIPT_INPUT_HARD_MAX=25000
# auto = 구간 규칙대로 | reject = 과거 동작 유지 | compress = 강제 압축 | split = 강제 분할
LONG_INPUT_MODE=auto
SCENE_NARRATION_MIN=70
SCENE_NARRATION_MAX=180

# -----------------------------------------------------------------------------
# 10) n8n Webhook (선택 · 외부 트리거/알림)
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
NOTIFY_ON_DONE=false

# -----------------------------------------------------------------------------
# 11) 원격 렌더 워커 분리 구성 - 선택
# -----------------------------------------------------------------------------
# render_worker 를 N100 에서 돌릴 때 사용
REMOTE_RENDER_ENABLED=false
REMOTE_RENDER_HOST=<render-worker-host>
REMOTE_RENDER_USER=<render-worker-user>
REMOTE_WORK_MOUNT=/mnt/ai-video/work

# -----------------------------------------------------------------------------
# 12) 운영
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
DRY_RUN=false
PARALLEL_TTS=1

# Public local service ports.
AIVIDEO_BACKEND_PORT=8902
AIVIDEO_FRONTEND_PORT=3902
